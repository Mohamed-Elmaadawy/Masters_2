{
  "requirement_set": {
    "doc_id": "themas-fischbach2022",
    "requirements": [
      {
        "id": "THEMAS-REQ-A",
        "text": "If the temperature change is requested, then the determine heating/cooling mode process is activated and makes a heating/cooling request.",
        "source_doc_id": "themas-fischbach2022"
      },
      {
        "id": "THEMAS-REQ-B",
        "text": "If the current temperature value is strictly less than the lower value of the valid temperature range or if the received temperature value is strictly greater than the upper value of the valid temperature range, then the THEMAS system shall identify the current temperature value as an invalid temperature and shall output an invalid temperature status.",
        "source_doc_id": "themas-fischbach2022"
      },
      {
        "id": "THEMAS-REQ-C",
        "text": "The THEMAS system shall maintain the ON/OFF status of each heating and cooling unit.",
        "source_doc_id": "themas-fischbach2022"
      },
      {
        "id": "THEMAS-REQ-D",
        "text": "Temperatures that do not exceed these limits shall be output for subsequent processing.",
        "source_doc_id": "themas-fischbach2022"
      },
      {
        "id": "THEMAS-REQ-E",
        "text": "If this condition is true, then this module shall output a request to turn on the heating unit in case LO = T_LT.",
        "source_doc_id": "themas-fischbach2022"
      },
      {
        "id": "THEMAS-REQ-F",
        "text": "The heating/cooling unit shall have no real time delay when these statuses are sent to the THEMAS system.",
        "source_doc_id": "themas-fischbach2022"
      },
      {
        "id": "THEMAS-REQ-G",
        "text": "Each thermostat shall have a unique identifier by which that thermostat is identified in the THEMAS system.",
        "source_doc_id": "themas-fischbach2022"
      },
      {
        "id": "THEMAS-REQ-H",
        "text": "When an event occurs, the THEMAS system shall identify the event type and format an appropriate event message.",
        "source_doc_id": "themas-fischbach2022"
      }
    ]
  },
