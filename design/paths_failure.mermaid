%% GENERATED by design/generate_diagrams.py -- do not edit by hand.
%% Rerun after every change to schemas.py.

%% What happens when a stage fails or the process is interrupted.
flowchart LR
    F0["Any per-requirement stage<br/><i>classifier · quality_checker · refiner<br/>strategy_selector · test_generator</i>"]
    FRETRY["Retry with backoff<br/><i>free-tier rate limits are the normal case</i>"]
    FOK["Continue normally"]
    FGONE["<i>no trace kept</i><br/>a successful retry is not recorded --<br/>retry_count only ever describes a call that FAILED"]
    FERR["<b>ERROR</b><br/>StageError: stage · kind · message · retry_count<br/><i>partial record still persisted</i>"]
    FKILL["Record already on disk<br/><i>written incrementally</i>"]
    FIP["<b>IN_PROGRESS</b><br/><i>not a failure -- the resume marker</i>"]
    FRES["Resume position derived from<br/>which fields are populated<br/><i>no stored pointer</i>"]

    F0 -->|"any stage raises"| FRETRY
    FRETRY -->|"a retry succeeds"| FOK
    FRETRY -->|"retries exhausted"| FERR
    FOK --> FGONE
    F0 -->|"process dies / interrupted"| FKILL
    FKILL --> FIP
    FIP --> FRES

    classDef io fill:#e8eaf6,stroke:#3f51b5,color:#1a237e
    class FKILL,FRES io
    classDef req fill:#fff8e1,stroke:#f9a825,color:#e65100
    class F0,FRETRY,FOK req
    classDef term fill:#ede7f6,stroke:#5e35b1,color:#311b92
    class FERR,FIP term
    classDef note fill:#ffffff,stroke:#9e9e9e,color:#424242,stroke-dasharray:3 3
