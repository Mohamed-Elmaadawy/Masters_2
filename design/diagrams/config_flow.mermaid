%% GENERATED by design/generate_arch_diagrams.py -- do not edit by hand.
%% Rerun after any structural change to design/ or orchestrator/.

%% Configuration, from the YAML file to the arguments run_document is actually called with, to what a finished run leaves on disk. Everything left of run_document happens before any API key is read.
flowchart TD
    YAML["run_config.yaml<br/><i>run_id · output_dir · max_revisions ·<br/>retry · rate_limits · defaults ·<br/>stages overrides · prompts</i>"]
    PROMPTS["8 prompt files<br/><i>one per stage, by path</i>"]
    RC["config.RunConfig<br/><i>shape only: keys known,<br/>prompts cover every stage</i>"]
    RES["config.resolve_run_config<br/><i>defaults + overrides per stage ·<br/>output_mode capability check ·<br/>prompt file read and hashed</i>"]
    RRC["config.ResolvedRunConfig<br/><i>8 x ResolvedStageConfig ·<br/>rate_limits must match resolved models exactly</i>"]
    CAP["providers.capabilities.supports_output_mode<br/><i>no network, no key -- a table</i>"]
    META["config.to_run_metadata<br/><i>-> schemas.RunMetadata,<br/>persisted with the record</i>"]
    THR["config.throttle_from<br/><i>rpm -> min seconds between calls,<br/>keyed by provider/model</i>"]
    RETRY["config.retry_args<br/><i>-> max_attempts, backoff_seconds(n)</i>"]
    RD["config.run_dir_for<br/><i>output_dir / run_id, re-checked<br/>to be inside output_dir</i>"]
    RUNDOC["pipeline.run_document(<br/>requirement_set, metadata, stage_fns,<br/>human_fns, throttle, max_revisions,<br/>run_dir, max_attempts, backoff_seconds)"]
    DIR["&lt;output_dir&gt;/&lt;run_id&gt;/"]
    F1["run_config.json<br/><i>the exact resolved config;<br/>a resume reloads this, not the YAML</i>"]
    F2["document.json<br/><i>DocumentRunRecord with<br/>requirement_records = []</i>"]
    F3["requirements/&lt;sha256 of id&gt;.json<br/><i>one RequirementRunRecord each;<br/>id is hashed so a hostile id<br/>cannot escape the directory</i>"]
    READ["pipeline.read_document_run<br/><i>reassembles both halves,<br/>sorted by requirement.id</i>"]

    YAML -->|"load_run_config"| RC
    RC --> RES
    PROMPTS -->|"read + sha256 -> prompt_hash"| RES
    RES -->|"per stage, before any key is read"| CAP
    RES --> RRC
    RRC --> META
    RRC --> THR
    RRC --> RETRY
    RRC --> RD
    META --> RUNDOC
    THR --> RUNDOC
    RETRY --> RUNDOC
    RD --> RUNDOC
    RD -->|"must not already exist"| DIR
    RRC -->|"write_run_config"| F1
    DIR --> F1
    DIR --> F2
    DIR --> F3
    RUNDOC -->|"write_document_run"| F2
    RUNDOC -->|"write_requirement_run"| F3
    F2 --> READ
    F3 --> READ

    classDef schema fill:#e8eaf6,stroke:#3f51b5,color:#1a237e
    class RC,RRC schema
    classDef req fill:#fff8e1,stroke:#f9a825,color:#e65100
    class RES,META,THR,RETRY,RD,RUNDOC,READ req
    classDef provider fill:#f3e5f5,stroke:#8e24aa,color:#4a148c
    class CAP provider
    classDef io fill:#e1f5fe,stroke:#0277bd,color:#01579b
    class YAML,PROMPTS,DIR,F1,F2,F3 io
