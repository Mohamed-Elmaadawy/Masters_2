%% GENERATED by design/generate_arch_diagrams.py -- do not edit by hand.
%% Rerun after any structural change to design/ or orchestrator/.

%% The orchestrator's call graph, CLI to disk. Every node names a real module.attribute, checked at generation time -- but the EDGES are declared, not traced: a call deleted while both functions survive is not caught here. Numbered edges are cli._run's order.
flowchart TD
    MAIN["python -m orchestrator.cli<br/>CONFIG.yaml INPUT.json"]
    RUN["cli._run<br/><i>argparse · exit codes 0/1/2/130</i>"]
    LOAD["config.load_run_config<br/><i>YAML -> RunConfig, shape only</i>"]
    RESOLVE["config.resolve_run_config<br/><i>defaults+overrides · capability check ·<br/>prompt hashing -> ResolvedRunConfig</i>"]
    RUNDIR["config.run_dir_for<br/><i>refuses to reuse an existing run dir</i>"]
    ADAPT["GeminiAdapter.from_env<br/>GroqAdapter.from_env<br/><i>API keys from env only</i>"]
    BUILD["cli._build_stage_fns<br/><i>8 factories -> StageFns</i>"]
    HUMAN["human_cli.answer_questions_cli<br/>human_cli.decide_at_cap_cli<br/><i>-> HumanFns</i>"]
    WCFG["config.write_run_config<br/><i>run_config.json</i>"]
    RDOC["pipeline.run_document<br/><i>the run</i>"]
    DSTAGES["pipeline.run_document_stages<br/><i>both doc stages, independently</i>"]
    CDS["pipeline.call_document_stage"]
    WDOC["pipeline.write_document_run<br/><i>document.json, requirement_records=[]</i>"]
    RREQ["pipeline.run_requirement<br/><i>once per requirement, in order</i>"]
    RESUMEAT{"pipeline.resume_at<br/><i>position derived from populated fields</i>"}
    CS["pipeline.call_stage<br/><i>see call_stage.mermaid</i>"]
    LOOP["pipeline._run_refine_loop<br/><i>quality check -> questions -> answers -><br/>rewrite -> re-check, until pass or cap</i>"]
    HFNS["HumanFns.answer_questions<br/>HumanFns.decide_at_cap"]
    SFNS["StageFns.<i>one of eight</i><br/><i>see stage_wiring.mermaid</i>"]
    THR["Throttle.wait_for_slot<br/><i>per model, before every call</i>"]
    WREQ["pipeline.write_requirement_run<br/><i>requirements/&lt;sha256&gt;.json ·<br/>also the mid-requirement checkpoint</i>"]
    ATOM["pipeline.atomic_write_text<br/><i>tmp file + os.replace</i>"]
    SUM["cli._print_summary<br/><i>outcome · per-requirement · tokens</i>"]
    RESUME["pipeline.resume_document<br/><b>no CLI wiring in v1</b>"]
    RETRYD["pipeline.retry_document_stage<br/><b>no CLI wiring in v1</b><br/><i>refuses once any requirement has run</i>"]
    RDOCR["pipeline.read_document_run<br/><i>document.json + requirements/*.json</i>"]

    MAIN --> RUN
    RUN -->|"1"| LOAD
    LOAD -->|"RunConfig"| RESOLVE
    RESOLVE -->|"ResolvedRunConfig"| RUNDIR
    RUNDIR -->|"2 · only now are keys read"| ADAPT
    ADAPT --> BUILD
    RUN --> HUMAN
    RUN -->|"3"| WCFG
    BUILD -->|"StageFns"| RDOC
    HUMAN -->|"HumanFns"| RDOC
    RDOC -->|"4"| DSTAGES
    DSTAGES -->|"x2, independently"| CDS
    RDOC -->|"5"| WDOC
    RDOC -->|"6 · per requirement"| RREQ
    RREQ --> RESUMEAT
    RESUMEAT -->|"start here"| CS
    RREQ -->|"if quality check failed"| LOOP
    LOOP --> CS
    LOOP -->|"RefinerTurn / at the cap"| HFNS
    CS --> THR
    THR --> SFNS
    CDS --> THR
    LOOP -->|"checkpoint before each human call"| WREQ
    RREQ -->|"after each requirement"| WREQ
    WREQ --> ATOM
    WDOC --> ATOM
    WCFG --> ATOM
    RDOC -->|"7 · DocumentRunRecord"| SUM
    ATOM -->|"later run"| RDOCR
    RDOCR --> RESUME
    RDOCR --> RETRYD
    RESUME -->|"pending_requirement_ids"| RREQ
    RETRYD -->|"one stage, new invocation_id"| CDS

    classDef doc fill:#e0f2f1,stroke:#00897b,color:#004d40
    class DSTAGES,CDS doc
    classDef req fill:#fff8e1,stroke:#f9a825,color:#e65100
    class RUN,LOAD,RESOLVE,RUNDIR,BUILD,RDOC,RREQ,CS,SFNS,THR req
    classDef human fill:#fce4ec,stroke:#c2185b,color:#880e4f
    class HUMAN,LOOP,HFNS human
    classDef decision fill:#f5f5f5,stroke:#616161,color:#212121
    class RESUMEAT decision
    classDef fail fill:#ffebee,stroke:#c62828,color:#b71c1c
    class RESUME,RETRYD fail
    classDef term fill:#ede7f6,stroke:#5e35b1,color:#311b92
    class SUM term
    classDef provider fill:#f3e5f5,stroke:#8e24aa,color:#4a148c
    class ADAPT provider
    classDef io fill:#e1f5fe,stroke:#0277bd,color:#01579b
    class MAIN,WCFG,WDOC,WREQ,ATOM,RDOCR io
