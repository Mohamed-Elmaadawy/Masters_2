%% GENERATED by design/generate_diagrams.py -- do not edit by hand.
%% Rerun after every change to schemas.py.

%% Every route a REQUIREMENT can take to a successful terminal outcome. Failure routes are in paths_failure.mermaid.
flowchart TD
    R0["Requirement picked up<br/><i>record created, outcome = IN_PROGRESS</i>"]
    RCL["2a · Classifier"]
    RQC["2b · Quality Checker<br/><i>new RefinementRound</i>"]
    RQ{"passed?"}
    RRF["2c · Refiner"]
    RHU["Human answers"]
    RSUP["id added to suppressed_issue_ids<br/><i>carried forward every later round</i>"]
    RRW["Rewrite<br/><i>becomes the next round's text_checked</i>"]
    RCAP{"revision cap reached?"}
    RASK["Ask human:<br/>generate anyway, or stop?"]
    R34["3 · Strategy Selector<br/>4 · Test Case Generator"]
    R34b["3 · Strategy Selector<br/>4 · Test Case Generator<br/><i>on the best-effort text</i>"]
    RDONE["<b>COMPLETED</b><br/><i>last round passed</i>"]
    RGEN["<b>CAP_GENERATED</b><br/>test plan produced<br/><i>from a requirement still failing checks</i>"]
    RSTOP["<b>CAP_STOPPED</b><br/><i>no strategy, no test plan</i>"]

    R0 --> RCL
    RCL --> RQC
    RQC --> RQ
    RQ -->|"passed"| R34
    RQ -->|"failed · issues raised"| RRF
    RRF -->|"RefinerTurn · questions"| RHU
    RHU -->|"RefinerAnswer · answers"| RRW
    RHU -->|"answer marked<br/>user_confirms_resolved"| RSUP
    RSUP --> RRW
    RRW --> RCAP
    RCAP -->|"no · next round checks the rewrite"| RQC
    RCAP -->|"yes · issues outstanding"| RASK
    RASK -->|"generate anyway"| R34b
    RASK -->|"stop"| RSTOP
    R34 --> RDONE
    R34b --> RGEN

    classDef io fill:#e8eaf6,stroke:#3f51b5,color:#1a237e
    class R0 io
    classDef req fill:#fff8e1,stroke:#f9a825,color:#e65100
    class RCL,RQC,RRW,R34,R34b req
    classDef human fill:#fce4ec,stroke:#c2185b,color:#880e4f
    class RRF,RHU,RSUP,RASK human
    classDef decision fill:#f5f5f5,stroke:#616161,color:#212121
    class RQ,RCAP decision
    classDef term fill:#ede7f6,stroke:#5e35b1,color:#311b92
    class RDONE,RGEN,RSTOP term
    classDef note fill:#ffffff,stroke:#9e9e9e,color:#424242,stroke-dasharray:3 3
