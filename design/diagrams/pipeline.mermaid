%% GENERATED by design/generate_diagrams.py -- do not edit by hand.
%% Rerun after every change to schemas.py.

flowchart TD
    IN["0 · Input<br/><i>full requirement document</i>"]
    CC["1 · Consistency Checker<br/><i>runs once per document</i>"]
    DM["1b · Dependency Mapper<br/><i>runs once per document</i>"]
    CL["2a · Classifier<br/><i>whole doc as context</i>"]
    QC["2b · Quality Checker"]
    PASS{"passed?"}
    RF["2c · Refiner<br/><i>human in the loop</i>"]
    HUM["Human answers"]
    CAP{"revision cap hit?"}
    ASK["Ask human:<br/>generate anyway, or stop?"]
    S3["3 · Test Design Strategy Selector"]
    S4["4 · Test Case Generator"]
    STOP["outcome = CAP_STOPPED<br/><i>no test plan produced</i>"]
    REC["RequirementRunRecord<br/><i>one file per requirement</i>"]
    DOC["DocumentRunRecord<br/><i>document.json — doc-level stages + set</i>"]

    IN -->|"RequirementSet"| CC
    IN -->|"RequirementSet"| DM
    IN -->|"RequirementSet"| DOC
    CC -->|"ConsistencyReport · or None if it failed · DEGRADED"| CL
    DM -->|"DependencyReport · or None if it failed · DEGRADED"| CL
    CC -->|"ConsistencyReport"| DOC
    DM -->|"DependencyReport"| DOC
    IN -->|"Requirement · one at a time"| CL
    CL -->|"Classification"| QC
    QC -->|"QualityReport"| PASS
    PASS -->|"no · issues found"| RF
    RF -->|"RefinerTurn · questions out"| HUM
    HUM -.->|"RefinerAnswer · answers in"| RF
    RF -->|"RefinedRequirement"| CAP
    CAP -->|"no · re-check rewritten text"| QC
    CAP -->|"yes · issues outstanding"| ASK
    ASK -->|"Requirement · generate anyway · CAP_GENERATED"| S3
    ASK -->|"stop"| STOP
    PASS -->|"Requirement · yes · COMPLETED"| S3
    S3 -->|"TestStrategy"| S4
    S4 -->|"TestPlan"| REC
    STOP --> REC

    NOTE0["Both branches converge on a plain <b>Requirement</b>.<br/>Clean requirements skip the Refiner entirely and pass<br/>the original object through; refined ones are rebuilt as<br/>Requirement(id, text=refined.refined_text). Stages 3/4<br/>never need to know which branch ran."]
    PASS -.- NOTE0
    class NOTE0 note
    NOTE1["RefinedRequirement is an <b>audit record</b> of what changed<br/>and why -- not the pipeline's transport type."]
    RF -.- NOTE1
    class NOTE1 note
    NOTE2["Second human interaction point. The answer is stored as the<br/>outcome (CAP_GENERATED / CAP_STOPPED) plus an optional<br/>cap_reason, so the decision lives in the data rather than<br/>only in whoever was at the keyboard."]
    ASK -.- NOTE2
    class NOTE2 note
    NOTE3["Any stage above can fail (free-tier rate limits).<br/>The record is created at outcome=IN_PROGRESS before<br/>stage 2a and written incrementally, so a failure stores<br/>outcome=ERROR + StageError instead of losing the record,<br/>and an interrupted run can resume."]
    REC -.- NOTE3
    class NOTE3 note
    NOTE4["If either document-level stage fails, processing<br/><b>continues without it</b> (decision D1b) and the document<br/>is marked DEGRADED with a DocumentStageError. Both can<br/>fail independently, so errors is a list.<br/><br/>On disk (decision D2b): document.json holds an empty<br/>requirement_records list; each requirement is its own file.<br/>pending_requirement_ids is derived, and drives resume."]
    DOC -.- NOTE4
    class NOTE4 note

    classDef io fill:#e8eaf6,stroke:#3f51b5,color:#1a237e
    class IN,REC,DOC io
    classDef doc fill:#e0f2f1,stroke:#00897b,color:#004d40
    class CC,DM doc
    classDef req fill:#fff8e1,stroke:#f9a825,color:#e65100
    class CL,QC,S3,S4 req
    classDef human fill:#fce4ec,stroke:#c2185b,color:#880e4f
    class RF,HUM,ASK human
    classDef decision fill:#f5f5f5,stroke:#616161,color:#212121
    class PASS,CAP decision
    classDef stop fill:#ffebee,stroke:#c62828,color:#b71c1c
    class STOP stop
    classDef note fill:#ffffff,stroke:#9e9e9e,color:#424242,stroke-dasharray:3 3
