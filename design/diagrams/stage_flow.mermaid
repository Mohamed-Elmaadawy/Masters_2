%% GENERATED by design/generate_arch_diagrams.py -- do not edit by hand.
%% Rerun after any structural change to design/ or orchestrator/.

%% The 8 LLM stages, normal flow only: happy-path order plus the one branch you can't drop and still call it a flow (did the quality check pass?). Dotted arrows are a document-level report being read, not the main sequence. No config, no retries, no revision cap -- see stage_wiring.mermaid and paths_requirement.mermaid for those.
flowchart TD
    subgraph Runs_once_per_document["Runs once per document"]
        CC["Consistency Checker"]
        DM["Dependency Mapper"]
    end
    subgraph Runs_once_per_requirement____repeated_for_every_requirement_in_the_document["Runs once per requirement -- repeated for every requirement in the document"]
        CL["Classifier"]
        QC["Quality Checker"]
        PASS{"Quality passed?"}
        RQ["Refiner: Ask Questions"]
        HUM["Human Answers"]
        RW["Refiner: Rewrite"]
        S3["Strategy Selector"]
        S4["Test Case Generator"]
    end
    IN["Requirement Document"]
    OUT["Test Cases"]

    IN --> CC
    IN --> DM
    IN --> CL
    CL --> QC
    CC -.->|"conflicts"| QC
    DM -.->|"dependencies"| QC
    QC --> PASS
    PASS -->|"yes"| S3
    PASS -->|"no"| RQ
    RQ --> HUM
    HUM --> RW
    RW -->|"try again"| QC
    DM -.->|"dependencies"| S3
    DM -.->|"dependencies"| S4
    S3 --> S4
    S4 --> OUT

    classDef doc fill:#e0f2f1,stroke:#00897b,color:#004d40
    class CC,DM doc
    classDef req fill:#fff8e1,stroke:#f9a825,color:#e65100
    class CL,QC,RQ,RW,S3,S4 req
    classDef human fill:#fce4ec,stroke:#c2185b,color:#880e4f
    class HUM human
    classDef decision fill:#f5f5f5,stroke:#616161,color:#212121
    class PASS decision
    classDef term fill:#ede7f6,stroke:#5e35b1,color:#311b92
    class OUT term
    classDef io fill:#e1f5fe,stroke:#0277bd,color:#01579b
    class IN io
