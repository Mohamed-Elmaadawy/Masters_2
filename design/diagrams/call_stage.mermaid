%% GENERATED by design/generate_arch_diagrams.py -- do not edit by hand.
%% Rerun after any structural change to design/ or orchestrator/.

%% One stage call: retry, validation and per-attempt accounting inside pipeline.call_stage / call_document_stage. Every AttemptResult and FailureKind member must appear here or this build fails.
flowchart TD
    A0["call_stage(...)<br/><i>attempt = 1 .. max_attempts</i>"]
    AT["Throttle.wait_for_slot(model)"]
    AC["stage_fn(*args)<br/><i>the provider call</i>"]
    AFATAL["StageCallFatal<br/><i>bad key · unsupported output mode</i><br/><i>FATAL_FAILURE · kind=FATAL</i>"]
    APART["StageCallPartial<br/><i>inference happened, output unusable</i><br/><b>carries tokens</b><br/><i>OTHER_FAILURE · kind=OTHER</i>"]
    AFAIL["StageCallFailed<br/><i>network · rate limit · timeout</i><br/><i>TRANSPORT_FAILURE · kind=TRANSPORT</i>"]
    AOTHER["any other Exception<br/><i>from the stage_fn only</i><br/><i>OTHER_FAILURE · kind=OTHER</i>"]
    AVAL{"model_cls.model_validate(raw)"}
    AVERR["ValidationError<br/><i>VALIDATION_FAILURE · kind=VALIDATION</i>"]
    AID{"requirement_id / doc_id<br/>matches the one asked about?"}
    AIDERR["answered about a different requirement<br/><i>VALIDATION_FAILURE · kind=VALIDATION</i>"]
    AEX{"extra_check(parsed)<br/><i>cross-stage agreement</i>"}
    AEXERR["extra_check returned a message<br/><i>VALIDATION_FAILURE · kind=VALIDATION</i>"]
    AOK["<b>return parsed</b><br/><i>SUCCESS</i>"]
    ABACK["sleep(backoff_seconds(attempt))<br/><i>next attempt</i>"]
    AEXH["<b>raise StageFailed</b><br/>kind · message · retry_count"]
    AREC["StageError on the record<br/><i>outcome = ERROR, partial record kept</i>"]
    ANOTE["Every branch above -- success and failure alike -- appends exactly one StageAttempt to the attempt sink, so a call that succeeds on attempt 3 still records what attempts 1 and 2 did and what they cost.<br/>Only StageCallPartial and the branches after a returned StageCallResult carry token counts: the rest were rejected before inference, so there is nothing to charge."]

    A0 --> AT
    AT --> AC
    AC -->|"raises"| AFATAL
    AC -->|"raises"| APART
    AC -->|"raises"| AFAIL
    AC -->|"raises"| AOTHER
    AC -->|"returns StageCallResult"| AVAL
    AVAL -->|"invalid"| AVERR
    AVAL -->|"valid"| AID
    AID -->|"no"| AIDERR
    AID -->|"yes"| AEX
    AEX -->|"disagrees"| AEXERR
    AEX -->|"None"| AOK
    AFATAL -->|"no retry · retry_count=0"| AEXH
    APART --> ABACK
    AFAIL --> ABACK
    AOTHER --> ABACK
    AVERR --> ABACK
    AIDERR --> ABACK
    AEXERR --> ABACK
    ABACK -->|"attempts left"| AT
    ABACK -->|"attempts exhausted"| AEXH
    AEXH --> AREC

    classDef req fill:#fff8e1,stroke:#f9a825,color:#e65100
    class A0,AT,AC,ABACK req
    classDef decision fill:#f5f5f5,stroke:#616161,color:#212121
    class AVAL,AID,AEX decision
    classDef fail fill:#ffebee,stroke:#c62828,color:#b71c1c
    class AFATAL,APART,AFAIL,AOTHER,AVERR,AIDERR,AEXERR fail
    classDef term fill:#ede7f6,stroke:#5e35b1,color:#311b92
    class AOK,AEXH,AREC term
    classDef note fill:#ffffff,stroke:#9e9e9e,color:#424242,stroke-dasharray:3 3
    class ANOTE note
    A0 -.- ANOTE
