%% Rerun after any structural change to design/ or orchestrator/.

%% The whole project in one picture. For any real detail, see the other eleven diagrams in design/diagrams/ -- this one is deliberately too small to debug from.
flowchart TD
    IN["Requirement document (JSON)<br/>+ run config (YAML)"]
    DOC["Document-level checks<br/><i>consistency · dependencies<br/>2 stages, once per document</i>"]
    REQ["Per-requirement pipeline<br/><i>classify → check quality →<br/>refine (loop) → select strategy → generate tests<br/>6 stages, repeated for every requirement</i>"]
    HUM["Human<br/><i>answers refiner questions ·<br/>decides at the revision cap</i>"]
    LLM["LLM providers<br/><i>Gemini · Groq</i>"]
    OUT["Run record<br/><i>JSON on disk · resumable</i>"]

    IN --> DOC
    IN --> REQ
    DOC -->|"conflicts · dependencies"| REQ
    DOC --> LLM
    REQ --> LLM
    REQ -->|"questions · cap decision"| HUM
    HUM -->|"answers"| REQ
    DOC --> OUT
    REQ --> OUT

    classDef doc fill:#e0f2f1,stroke:#00897b,color:#004d40
    class DOC doc
    classDef req fill:#fff8e1,stroke:#f9a825,color:#e65100
    class REQ req
    classDef human fill:#fce4ec,stroke:#c2185b,color:#880e4f
    class HUM human
    classDef term fill:#ede7f6,stroke:#5e35b1,color:#311b92
    class OUT term
    classDef provider fill:#f3e5f5,stroke:#8e24aa,color:#4a148c
    class LLM provider
    classDef io fill:#e1f5fe,stroke:#0277bd,color:#01579b
    class IN io
