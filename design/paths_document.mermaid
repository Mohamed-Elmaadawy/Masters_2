%% GENERATED by design/generate_diagrams.py -- do not edit by hand.
%% Rerun after every change to schemas.py.

%% Every route a DOCUMENT can take through the two document-level stages.
flowchart TD
    D0["0 · RequirementSet loaded<br/><i>outcome = IN_PROGRESS</i>"]
    DCC["1 · Consistency Checker"]
    DDM["1b · Dependency Mapper"]
    DDMx["1b · Dependency Mapper<br/><i>consistency report absent</i>"]
    DOK["<b>COMPLETED</b><br/>both reports present<br/>per-requirement processing begins"]
    DDEG1["<b>DEGRADED</b><br/>dependency report missing<br/><i>stages 3/4 run without dependency context</i>"]
    DDEG2["<b>DEGRADED</b><br/>consistency report missing<br/><i>Quality Checker inherits no conflict flags</i>"]
    DDEG3["<b>DEGRADED</b><br/>both missing<br/><i>errors is a list for exactly this case</i>"]

    D0 --> DCC
    DCC -->|"succeeded"| DDM
    DCC -->|"failed after retries"| DDMx
    DDM -->|"succeeded"| DOK
    DDM -->|"failed after retries"| DDEG1
    DDMx -->|"succeeded"| DDEG2
    DDMx -->|"failed after retries"| DDEG3

    classDef io fill:#e8eaf6,stroke:#3f51b5,color:#1a237e
    class D0 io
    classDef doc fill:#e0f2f1,stroke:#00897b,color:#004d40
    class DCC,DDM,DDMx doc
    classDef term fill:#ede7f6,stroke:#5e35b1,color:#311b92
    class DOK,DDEG1,DDEG2,DDEG3 term
    classDef note fill:#ffffff,stroke:#9e9e9e,color:#424242,stroke-dasharray:3 3
